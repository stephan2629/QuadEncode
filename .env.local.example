NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL used to build auth email links (signup confirmation, password
# reset). Must match a URL allow-listed in Supabase Dashboard -> Authentication
# -> URL Configuration. Defaults to http://localhost:3000 if unset.
# Production: https://quadencode.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers for subject search, resource descriptions, import parsing, and
# quiz generation (src/lib/ai.ts). Tried in order: Gemini, then OpenAI. Only
# Gemini is required to run the app; OpenAI is an optional fallback used
# when Gemini is rate-limited, overloaded, or unset.
GEMINI_API_KEY=your-gemini-api-key
# Optional second Gemini key, tried if the first is rate-limited/exhausted.
Gemini_API_Key2=
OPENAI_API_KEY=

# Learning path discovery (Phase 4)
SERPER_API_KEY=your-serper-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
